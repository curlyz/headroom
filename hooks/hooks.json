{
  "description": "headroom: gate every Bash command on CPU, memory and disk; enforce HEADROOM_TIMEOUT",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/headroom.py\" hook --harness claude",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
